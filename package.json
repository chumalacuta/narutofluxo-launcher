{
  "name": "fluxolauncher",
  "version": "2.2.2",
  "productName": "Fluxo Launcher",
  "description": "Launcher Oficial do Naruto Fluxo!",
  "author": "NarutoFluxo",
  "license": "UNLICENSED",
  "homepage": "https://github.com/chumalacuta/narutofluxo-launcher",
  "bugs": {
    "url": "https://github.com/chumalacuta/narutofluxo-launcher/issues"
  },
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder build",
    "dist:win": "npm run dist -- -w",
    "dist:mac": "npm run dist -- -m",
    "dist:linux": "npm run dist -- -l",
    "lint": "eslint --config .eslintrc.json .",
    "test": "node --test tests/*.test.js",
    "prepare:pack": "python tools/prepare_pack.py",
    "verify:pack": "node tools/verify_pack.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "adm-zip": "0.6.1",
    "discord-rpc-patch": "^4.0.1",
    "ejs": "^3.1.10",
    "ejs-electron": "^3.0.0",
    "electron-updater": "^6.3.9",
    "fs-extra": "^11.1.1",
    "github-syntax-dark": "^0.5.0",
    "got": "^11.8.5",
    "helios-core": "~2.2.4",
    "helios-distribution-types": "^1.3.0",
    "jquery": "^3.7.1",
    "lodash.merge": "^4.6.2",
    "semver": "^7.6.3",
    "toml": "5.0.1"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chumalacuta/narutofluxo-launcher.git"
  }
}
